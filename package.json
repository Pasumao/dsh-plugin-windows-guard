{
  "name": "dsh-plugin-windows-guard",
  "description": "DeepSeek Harness (dsh) Windows 环境防坑插件：两个防坑 skill（windows-enc/windows-sys：编码/转义/路径/进程/乱码预防规则）+ 三层主动防护（pwsh 结果乱码检测提示、危险写命令拦截、windows_encode_detect/fix 编码诊断修复工具）。零运行时依赖，零构建。",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "scripts"
  ],
  "scripts": {
    "pack": "npm pack",
    "selfcheck": "node scripts/selfcheck.mjs",
    "smoke": "node scripts/selfcheck.mjs && node scripts/smoke-server.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "skill",
    "tools",
    "guard",
    "windows",
    "powershell",
    "encoding",
    "utf-8",
    "gbk",
    "bom",
    "mojibake",
    "garbled-text",
    "powershell-guard",
    "write-guard",
    "hook"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Pasumao/dsh-plugin-windows-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasumao/dsh-plugin-windows-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Pasumao/dsh-plugin-windows-guard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
